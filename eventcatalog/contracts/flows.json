          "id": "StartMediaRecording",
          "version": "1.0.0"
        },
        "next_step": {
          "id": "5"
        }
      },
      {
        "id": "5",
        "title": "Start owner-bound recording",
        "message": {
          "id": "StartSessionMediaCapture",
          "version": "1.0.0"
        },
        "next_step": {
          "id": "6"
        }
      },
