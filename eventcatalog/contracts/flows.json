      },
      {
        "id": "10",
        "title": "Read event timeline",
        "message": {
          "id": "GetSessionEvents",
          "version": "1.0.0"
        },
        "next_step": {
          "id": "11"
        }
      },
      {
        "id": "11",
        "title": "Read optional session-linked media",
        "message": {
          "id": "GetRecordingPlayback",
          "version": "1.0.0"
        }
      }
    ],
    "description": "Event capture is mandatory regardless of media policy or recovery policy. Media steps are optional; auto-enabled game profiles run them on allocation, manual start covers only the future interval. The event archive seals only after terminal metadata and all source end-watermarks reconcile. Crash gaps are explicit; planned engine drain waits for final writes and recording resources. Playback needs separate authorized access."
  }
