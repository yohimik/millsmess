        "id": "9",
        "title": "Read page with freshness watermark",
        "message": {
          "id": "GetLeaderboard",
          "version": "1.0.0"
        }
      }
    ],
    "description": "The diagram shows logical dependencies, not a transaction across three databases. PostgreSQL settlement commits before the event; Redis and ClickHouse run independent asynchronous projections. Failure of either projection cannot undo or duplicate settled results. Rebuild from PostgreSQL/outbox and report lag."
  },
  {
    "id": "SessionRecording",
    "name": "Record every session and optional audio/video",
    "summary": "Mandatory durable timestamped events with optional media attached to the same session.",
    "steps": [
      {
        "id": "1",
        "title": "Set optional media policy",
        "actor": {
          "name": "Host / operator"
        },
        "next_step": {
          "id": "2"
        }
      },
      {
        "id": "2",
        "title": "Require durable event recorder",
        "message": {
          "id": "AllocateSession",
          "version": "1.0.0"
        },
        "next_step": {
          "id": "3"
        }
      },
      {
        "id": "3",
        "title": "Capture each accepted session event",
        "message": {
          "id": "SessionEventRecorded",
          "version": "1.0.0"
        },
        "next_step": {
          "id": "4"
        }
      },
      {
        "id": "4",
        "title": "Optionally enable audio/video",
