{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetLeaderboard",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "GetLeaderboard"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/GetLeaderboardData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "GetLeaderboardData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boardId": {
          "$ref": "#/$defs/ID"
        },
        "seasonId": {
          "$ref": "#/$defs/ID"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "aroundPlayerId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "boardId",
        "seasonId",
        "limit"
      ],
      "not": {
        "required": [
          "cursor",
          "aroundPlayerId"
        ],
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "aroundPlayerId": {
            "$ref": "#/$defs/ID"
          }
        }
      }
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
