{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "CommandResult"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/CommandResultData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "CommandResultData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "result"
      ]
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "forbidden",
        "not-found",
        "conflict",
        "capacity-exhausted",
        "region-unavailable",
        "stale-epoch",
        "stale-revision",
        "draining",
        "expired",
        "unsupported-capability",
        "invalid-payload",
        "rate-limited",
        "resync-required",
        "idempotency-conflict",
        "retryable-unavailable"
      ]
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "completed",
            "rejected"
          ]
        },
        "resourceId": {
          "$ref": "#/$defs/ID"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "requestId",
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/ErrorCode"
              }
            }
          }
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
