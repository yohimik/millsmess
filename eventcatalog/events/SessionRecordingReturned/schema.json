{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionRecordingReturned",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "SessionRecordingReturned"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/SessionRecordingReturnedData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "SessionRecordingIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "eventsRequired": {
          "type": "boolean",
          "const": true
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "sealing",
            "sealed",
            "incomplete"
          ]
        },
        "eventCount": {
          "$ref": "#/$defs/Counter"
        },
        "archiveWatermark": {
          "$ref": "#/$defs/Counter"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "retainedUntil": {
          "$ref": "#/$defs/Timestamp"
        },
        "timelineDigest": {
          "$ref": "#/$defs/Digest"
        },
        "mediaRecordingIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ID"
          },
          "maxItems": 128
        }
      },
      "required": [
        "sessionId",
        "eventsRequired",
        "state",
        "eventCount",
        "archiveWatermark",
        "startedAt",
        "retainedUntil",
        "mediaRecordingIds"
      ]
    },
    "SessionRecordingReturnedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recording": {
          "$ref": "#/$defs/SessionRecordingIndex"
        }
      },
      "required": [
        "recording"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
