{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaFrame",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "MediaFrame"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/MediaFrameData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Bytes": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 87384,
      "description": "Canonical padded base64. Decoded size and negotiated transport budget also enforced."
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "MediaFrameData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "channelId": {
          "$ref": "#/$defs/ID"
        },
        "connectionGeneration": {
          "$ref": "#/$defs/Counter"
        },
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "mediaTimestamp": {
          "$ref": "#/$defs/Counter"
        },
        "payload": {
          "$ref": "#/$defs/Bytes"
        },
        "kind": {
          "type": "string",
          "enum": [
            "audio",
            "video"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timescale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "keyFrame": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "playerId",
        "channelId",
        "connectionGeneration",
        "sequence",
        "mediaTimestamp",
        "payload",
        "kind",
        "codec",
        "timescale",
        "duration",
        "keyFrame"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
