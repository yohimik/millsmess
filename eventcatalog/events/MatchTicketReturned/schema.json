{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchTicketReturned",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "MatchTicketReturned"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/MatchTicketReturnedData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "MatchTicket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticketId": {
          "$ref": "#/$defs/ID"
        },
        "partyId": {
          "$ref": "#/$defs/ID"
        },
        "policyId": {
          "$ref": "#/$defs/ID"
        },
        "policyRevision": {
          "$ref": "#/$defs/Counter"
        },
        "regionId": {
          "$ref": "#/$defs/ID"
        },
        "clusterId": {
          "$ref": "#/$defs/ID"
        },
        "state": {
          "$ref": "#/$defs/TicketState"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "proposalId": {
          "$ref": "#/$defs/ID"
        },
        "sessionId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "ticketId",
        "policyId",
        "policyRevision",
        "regionId",
        "clusterId",
        "state",
        "revision",
        "createdAt",
        "expiresAt"
      ]
    },
    "MatchTicketReturnedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "$ref": "#/$defs/MatchTicket"
        }
      },
      "required": [
        "ticket"
      ]
    },
    "TicketState": {
      "type": "string",
      "enum": [
        "queued",
        "proposed",
        "matched",
        "cancelled",
        "expired"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
