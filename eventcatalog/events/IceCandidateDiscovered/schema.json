{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IceCandidateDiscovered",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "IceCandidateDiscovered"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/IceCandidateDiscoveredData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "IceCandidateDiscoveredData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "negotiationId": {
          "$ref": "#/$defs/ID"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sdpMid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sdpMLineIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "playerId",
        "negotiationId",
        "candidate",
        "sdpMid",
        "sdpMLineIndex"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
