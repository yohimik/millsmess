{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionEventStreamClosed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "SessionEventStreamClosed"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/SessionEventStreamClosedData"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "SessionEventStreamClosedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "streamId": {
          "$ref": "#/$defs/ID"
        },
        "source": {
          "type": "string",
          "enum": [
            "Core",
            "Socket",
            "MediaEngine"
          ]
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "lastSequence": {
          "$ref": "#/$defs/Counter"
        },
        "eventCount": {
          "$ref": "#/$defs/Counter"
        },
        "closedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "streamDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "sessionId",
        "streamId",
        "source",
        "ownerEpoch",
        "lastSequence",
        "eventCount",
        "closedAt",
        "streamDigest"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
