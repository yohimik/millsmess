{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionAdmissionGranted",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "SessionAdmissionGranted"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/SessionAdmissionGrantedData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "regionId": {
          "$ref": "#/$defs/ID"
        },
        "clusterId": {
          "$ref": "#/$defs/ID"
        },
        "engineId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "transport",
        "url",
        "regionId",
        "clusterId",
        "engineId"
      ]
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "SessionAdmissionGrantedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "membershipRevision": {
          "$ref": "#/$defs/Counter"
        },
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "maxItems": 8
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "playerId",
        "membershipRevision",
        "ticket",
        "expiresAt",
        "endpoints"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Transport": {
      "type": "string",
      "enum": [
        "websocket",
        "webrtc-datachannel",
        "udp",
        "webrtc-rtp"
      ]
    }
  }
}
