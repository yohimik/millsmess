{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegionsDiscovered",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "RegionsDiscovered"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/RegionsDiscoveredData"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionId": {
          "$ref": "#/$defs/ID"
        },
        "clusterId": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepting",
            "draining",
            "unavailable"
          ]
        },
        "controlUrl": {
          "type": "string",
          "format": "uri"
        },
        "socketUrl": {
          "type": "string",
          "format": "uri"
        },
        "discoveryRevision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "regionId",
        "clusterId",
        "status",
        "controlUrl",
        "socketUrl",
        "discoveryRevision"
      ]
    },
    "RegionsDiscoveredData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Region"
          },
          "maxItems": 128
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "regions",
        "expiresAt"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
