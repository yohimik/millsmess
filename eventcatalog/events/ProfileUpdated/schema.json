{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileUpdated",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "ProfileUpdated"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/ProfileUpdatedData"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "$ref": "#/$defs/ID"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "deleted"
          ]
        }
      },
      "required": [
        "userId",
        "displayName",
        "revision",
        "status"
      ]
    },
    "ProfileUpdatedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/Profile"
        }
      },
      "required": [
        "profile"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
