{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckpointCommitted",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "CheckpointCommitted"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/CheckpointCommittedData"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "Checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpointId": {
          "$ref": "#/$defs/ID"
        },
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "tick": {
          "$ref": "#/$defs/Counter"
        },
        "lastInputOffset": {
          "$ref": "#/$defs/Counter"
        },
        "buildDigest": {
          "$ref": "#/$defs/Digest"
        },
        "stateDigest": {
          "$ref": "#/$defs/Digest"
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "checkpointId",
        "sessionId",
        "ownerEpoch",
        "tick",
        "lastInputOffset",
        "buildDigest",
        "stateDigest",
        "objectKey",
        "createdAt"
      ]
    },
    "CheckpointCommittedData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        }
      },
      "required": [
        "checkpoint"
      ]
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
