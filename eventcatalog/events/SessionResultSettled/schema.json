{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionResultSettled",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "SessionResultSettled"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/SessionResultSettledData"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "MetricValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricId": {
          "$ref": "#/$defs/ID"
        },
        "value": {
          "$ref": "#/$defs/SignedValue"
        }
      },
      "required": [
        "metricId",
        "value"
      ]
    },
    "PlayerResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "teamId": {
          "$ref": "#/$defs/ID"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "win",
            "loss",
            "draw",
            "completed",
            "forfeit"
          ]
        },
        "statistics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "maxItems": 64
        }
      },
      "required": [
        "playerId",
        "teamId",
        "outcome",
        "statistics"
      ]
    },
    "SeasonResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resultId": {
          "$ref": "#/$defs/ID"
        },
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "seasonId": {
          "$ref": "#/$defs/ID"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "finalTick": {
          "$ref": "#/$defs/Counter"
        },
        "endedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlayerResult"
          },
          "maxItems": 10000
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "resultId",
        "sessionId",
        "ownerEpoch",
        "seasonId",
        "revision",
        "finalTick",
        "endedAt",
        "players",
        "digest"
      ]
    },
    "SessionResultSettledData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/SeasonResult"
        }
      },
      "required": [
        "result"
      ]
    },
    "SignedValue": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})$",
      "description": "Signed fixed-point integer string; metric definition supplies scale. No floating-point ranking."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
