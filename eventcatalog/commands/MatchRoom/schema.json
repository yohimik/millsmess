{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchRoom",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "MatchRoom"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/MatchRoomData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey"
  ],
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "MatchRoomData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameId": {
          "$ref": "#/$defs/ID"
        },
        "regionId": {
          "$ref": "#/$defs/ID"
        },
        "clusterId": {
          "$ref": "#/$defs/ID"
        },
        "skillBucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "policyId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "gameId",
        "regionId",
        "clusterId",
        "skillBucket",
        "policyId"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
