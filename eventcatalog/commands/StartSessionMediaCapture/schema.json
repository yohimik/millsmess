{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StartSessionMediaCapture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "StartSessionMediaCapture"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/StartSessionMediaCaptureData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "RecordingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventsRequired": {
          "type": "boolean",
          "const": true
        },
        "audioEnabled": {
          "type": "boolean"
        },
        "videoEnabled": {
          "type": "boolean"
        },
        "eventRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "mediaRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "segmentDurationMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 10000
        },
        "mediaFailureMode": {
          "type": "string",
          "enum": [
            "continue-with-gap",
            "end-session"
          ]
        },
        "policyRevision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "eventsRequired",
        "audioEnabled",
        "videoEnabled",
        "eventRetentionDays",
        "mediaRetentionDays",
        "segmentDurationMs",
        "mediaFailureMode",
        "policyRevision"
      ]
    },
    "StartSessionMediaCaptureData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "recordingId": {
          "$ref": "#/$defs/ID"
        },
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/RecordingPolicy"
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "recordingId",
        "audio",
        "video",
        "policy"
      ],
      "not": {
        "properties": {
          "audio": {
            "const": false
          },
          "video": {
            "const": false
          }
        },
        "required": [
          "audio",
          "video"
        ]
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
