{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connect",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "Connect"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/ConnectData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey"
  ],
  "$defs": {
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transport"
          },
          "maxItems": 4
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelKind"
          },
          "maxItems": 3
        },
        "codecs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 32
        },
        "protocolVersions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "maxItems": 4
        }
      },
      "required": [
        "transports",
        "kinds",
        "codecs",
        "protocolVersions"
      ]
    },
    "ChannelKind": {
      "type": "string",
      "enum": [
        "audio",
        "video",
        "game"
      ]
    },
    "ConnectData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        }
      },
      "required": [
        "accessToken",
        "capabilities"
      ]
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Transport": {
      "type": "string",
      "enum": [
        "websocket",
        "webrtc-datachannel",
        "udp",
        "webrtc-rtp"
      ]
    }
  }
}
