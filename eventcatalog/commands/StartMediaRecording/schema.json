{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StartMediaRecording",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "StartMediaRecording"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/StartMediaRecordingData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "StartMediaRecordingData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "sessionId",
        "audio",
        "video",
        "expectedRevision"
      ],
      "not": {
        "properties": {
          "audio": {
            "const": false
          },
          "video": {
            "const": false
          }
        },
        "required": [
          "audio",
          "video"
        ]
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
