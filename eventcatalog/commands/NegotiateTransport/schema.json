{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NegotiateTransport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "NegotiateTransport"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/NegotiateTransportData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "NegotiateTransportData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "negotiationId": {
          "$ref": "#/$defs/ID"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "sdpOffer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "playerId",
        "ticket",
        "negotiationId",
        "transport"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Transport": {
      "type": "string",
      "enum": [
        "websocket",
        "webrtc-datachannel",
        "udp",
        "webrtc-rtp"
      ]
    }
  }
}
