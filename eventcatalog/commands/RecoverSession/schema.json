{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecoverSession",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "RecoverSession"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/RecoverSessionData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    },
    "aggregateId": {
      "$ref": "#/$defs/ID"
    },
    "aggregateRevision": {
      "$ref": "#/$defs/Counter"
    },
    "causationId": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey",
    "aggregateId",
    "aggregateRevision",
    "causationId"
  ],
  "$defs": {
    "ChannelKind": {
      "type": "string",
      "enum": [
        "audio",
        "video",
        "game"
      ]
    },
    "ChannelSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "$ref": "#/$defs/ID"
        },
        "kind": {
          "$ref": "#/$defs/ChannelKind"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "reliability": {
          "$ref": "#/$defs/Reliability"
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "maxPayloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxRateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        }
      },
      "required": [
        "channelId",
        "kind",
        "transport",
        "reliability",
        "codec",
        "maxPayloadBytes",
        "maxRateHz"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "websocket"
              }
            }
          },
          "then": {
            "properties": {
              "reliability": {
                "const": "reliable-ordered"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "enum": [
                  "udp",
                  "webrtc-rtp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reliability": {
                "const": "unreliable-sequenced"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "webrtc-rtp"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "audio",
                  "video"
                ]
              }
            }
          }
        }
      ]
    },
    "Checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpointId": {
          "$ref": "#/$defs/ID"
        },
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "tick": {
          "$ref": "#/$defs/Counter"
        },
        "lastInputOffset": {
          "$ref": "#/$defs/Counter"
        },
        "buildDigest": {
          "$ref": "#/$defs/Digest"
        },
        "stateDigest": {
          "$ref": "#/$defs/Digest"
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "checkpointId",
        "sessionId",
        "ownerEpoch",
        "tick",
        "lastInputOffset",
        "buildDigest",
        "stateDigest",
        "objectKey",
        "createdAt"
      ]
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "GameProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameId": {
          "$ref": "#/$defs/ID"
        },
        "buildDigest": {
          "$ref": "#/$defs/Digest"
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxSpectators": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "tickRateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "maxSessionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "emptyTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "recoveryPolicy": {
          "$ref": "#/$defs/RecoveryPolicy"
        },
        "checkpointIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "inputRetentionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "maxItems": 32
        },
        "recording": {
          "$ref": "#/$defs/RecordingPolicy"
        }
      },
      "required": [
        "gameId",
        "buildDigest",
        "maxPlayers",
        "maxSpectators",
        "tickRateHz",
        "maxSessionSeconds",
        "emptyTimeoutSeconds",
        "recoveryPolicy",
        "checkpointIntervalSeconds",
        "inputRetentionSeconds",
        "channels",
        "recording"
      ]
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "RecordingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventsRequired": {
          "type": "boolean",
          "const": true
        },
        "audioEnabled": {
          "type": "boolean"
        },
        "videoEnabled": {
          "type": "boolean"
        },
        "eventRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "mediaRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "segmentDurationMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 10000
        },
        "mediaFailureMode": {
          "type": "string",
          "enum": [
            "continue-with-gap",
            "end-session"
          ]
        },
        "policyRevision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "eventsRequired",
        "audioEnabled",
        "videoEnabled",
        "eventRetentionDays",
        "mediaRetentionDays",
        "segmentDurationMs",
        "mediaFailureMode",
        "policyRevision"
      ]
    },
    "RecoverSessionData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "engineId": {
          "$ref": "#/$defs/ID"
        },
        "incarnationId": {
          "$ref": "#/$defs/ID"
        },
        "allocationId": {
          "$ref": "#/$defs/ID"
        },
        "leaseExpiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "replayThroughOffset": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "sessionId",
        "ownerEpoch",
        "engineId",
        "incarnationId",
        "allocationId",
        "leaseExpiresAt",
        "session",
        "checkpoint",
        "replayThroughOffset"
      ]
    },
    "RecoveryPolicy": {
      "type": "string",
      "enum": [
        "checkpoint-replay",
        "abort"
      ]
    },
    "Reliability": {
      "type": "string",
      "enum": [
        "reliable-ordered",
        "reliable-unordered",
        "unreliable-sequenced"
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/ID"
        },
        "roomId": {
          "$ref": "#/$defs/ID"
        },
        "regionId": {
          "$ref": "#/$defs/ID"
        },
        "clusterId": {
          "$ref": "#/$defs/ID"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "ownerEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "engineId": {
          "$ref": "#/$defs/ID"
        },
        "game": {
          "$ref": "#/$defs/GameProfile"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endsBy": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "sessionId",
        "roomId",
        "regionId",
        "clusterId",
        "state",
        "revision",
        "ownerEpoch",
        "game",
        "endsBy"
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "allocating",
        "starting",
        "active",
        "ending",
        "ended",
        "recovering",
        "failed"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Transport": {
      "type": "string",
      "enum": [
        "websocket",
        "webrtc-datachannel",
        "udp",
        "webrtc-rtp"
      ]
    }
  }
}
