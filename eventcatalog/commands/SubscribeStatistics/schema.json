{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubscribeStatistics",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "#/$defs/ID"
    },
    "type": {
      "type": "string",
      "const": "SubscribeStatistics"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "tenantId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "correlationId": {
      "$ref": "#/$defs/ID"
    },
    "data": {
      "$ref": "#/$defs/SubscribeStatisticsData"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "tenantId",
    "regionId",
    "clusterId",
    "correlationId",
    "data",
    "idempotencyKey"
  ],
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "SubscribeStatisticsData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playerIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ID"
          },
          "maxItems": 32
        },
        "boardIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ID"
          },
          "maxItems": 16
        },
        "seasonId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "playerIds",
        "boardIds",
        "seasonId"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
