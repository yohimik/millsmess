{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionRecordingIndex",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "$ref": "#/$defs/ID"
    },
    "eventsRequired": {
      "type": "boolean",
      "const": true
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "sealing",
        "sealed",
        "incomplete"
      ]
    },
    "eventCount": {
      "$ref": "#/$defs/Counter"
    },
    "archiveWatermark": {
      "$ref": "#/$defs/Counter"
    },
    "startedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "endedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "retainedUntil": {
      "$ref": "#/$defs/Timestamp"
    },
    "timelineDigest": {
      "$ref": "#/$defs/Digest"
    },
    "mediaRecordingIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ID"
      },
      "maxItems": 128
    }
  },
  "required": [
    "sessionId",
    "eventsRequired",
    "state",
    "eventCount",
    "archiveWatermark",
    "startedAt",
    "retainedUntil",
    "mediaRecordingIds"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
