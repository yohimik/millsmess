{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaRecording",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordingId": {
      "$ref": "#/$defs/ID"
    },
    "sessionId": {
      "$ref": "#/$defs/ID"
    },
    "state": {
      "$ref": "#/$defs/MediaRecordingState"
    },
    "revision": {
      "$ref": "#/$defs/Counter"
    },
    "audio": {
      "type": "boolean"
    },
    "video": {
      "type": "boolean"
    },
    "startedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "endedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "retainedUntil": {
      "$ref": "#/$defs/Timestamp"
    },
    "segmentCount": {
      "$ref": "#/$defs/Counter"
    },
    "gapCount": {
      "$ref": "#/$defs/Counter"
    },
    "manifestDigest": {
      "$ref": "#/$defs/Digest"
    }
  },
  "required": [
    "recordingId",
    "sessionId",
    "state",
    "revision",
    "audio",
    "video",
    "startedAt",
    "retainedUntil",
    "segmentCount",
    "gapCount"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "MediaRecordingState": {
      "type": "string",
      "enum": [
        "starting",
        "recording",
        "finalizing",
        "completed",
        "partial",
        "failed"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
