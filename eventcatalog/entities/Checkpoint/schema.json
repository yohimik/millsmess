{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkpointId": {
      "$ref": "#/$defs/ID"
    },
    "sessionId": {
      "$ref": "#/$defs/ID"
    },
    "ownerEpoch": {
      "$ref": "#/$defs/Counter"
    },
    "tick": {
      "$ref": "#/$defs/Counter"
    },
    "lastInputOffset": {
      "$ref": "#/$defs/Counter"
    },
    "buildDigest": {
      "$ref": "#/$defs/Digest"
    },
    "stateDigest": {
      "$ref": "#/$defs/Digest"
    },
    "objectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "checkpointId",
    "sessionId",
    "ownerEpoch",
    "tick",
    "lastInputOffset",
    "buildDigest",
    "stateDigest",
    "objectKey",
    "createdAt"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
