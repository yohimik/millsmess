{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Region",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepting",
        "draining",
        "unavailable"
      ]
    },
    "controlUrl": {
      "type": "string",
      "format": "uri"
    },
    "socketUrl": {
      "type": "string",
      "format": "uri"
    },
    "discoveryRevision": {
      "$ref": "#/$defs/Counter"
    }
  },
  "required": [
    "regionId",
    "clusterId",
    "status",
    "controlUrl",
    "socketUrl",
    "discoveryRevision"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    }
  }
}
