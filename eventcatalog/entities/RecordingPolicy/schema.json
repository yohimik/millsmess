{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecordingPolicy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventsRequired": {
      "type": "boolean",
      "const": true
    },
    "audioEnabled": {
      "type": "boolean"
    },
    "videoEnabled": {
      "type": "boolean"
    },
    "eventRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "mediaRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "segmentDurationMs": {
      "type": "integer",
      "minimum": 250,
      "maximum": 10000
    },
    "mediaFailureMode": {
      "type": "string",
      "enum": [
        "continue-with-gap",
        "end-session"
      ]
    },
    "policyRevision": {
      "$ref": "#/$defs/Counter"
    }
  },
  "required": [
    "eventsRequired",
    "audioEnabled",
    "videoEnabled",
    "eventRetentionDays",
    "mediaRetentionDays",
    "segmentDurationMs",
    "mediaFailureMode",
    "policyRevision"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    }
  }
}
