{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roomId": {
      "$ref": "#/$defs/ID"
    },
    "gameId": {
      "$ref": "#/$defs/ID"
    },
    "regionId": {
      "$ref": "#/$defs/ID"
    },
    "clusterId": {
      "$ref": "#/$defs/ID"
    },
    "revision": {
      "$ref": "#/$defs/Counter"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "locked",
        "closed"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "maxItems": 10000
    }
  },
  "required": [
    "roomId",
    "gameId",
    "regionId",
    "clusterId",
    "revision",
    "status",
    "participants"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "$ref": "#/$defs/ID"
        },
        "userId": {
          "$ref": "#/$defs/ID"
        },
        "role": {
          "type": "string",
          "enum": [
            "player",
            "spectator"
          ]
        },
        "membershipRevision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "playerId",
        "userId",
        "role",
        "membershipRevision"
      ]
    }
  }
}
