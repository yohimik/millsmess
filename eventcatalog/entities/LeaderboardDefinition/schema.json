{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeaderboardDefinition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "boardId": {
      "$ref": "#/$defs/ID"
    },
    "seasonId": {
      "$ref": "#/$defs/ID"
    },
    "metricId": {
      "$ref": "#/$defs/ID"
    },
    "direction": {
      "type": "string",
      "enum": [
        "descending",
        "ascending"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "regional",
        "global"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closing",
        "finalized"
      ]
    },
    "tieBreak": {
      "type": "string",
      "enum": [
        "player-id-ascending"
      ]
    },
    "scoreScale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "revision": {
      "$ref": "#/$defs/Counter"
    }
  },
  "required": [
    "boardId",
    "seasonId",
    "metricId",
    "direction",
    "scope",
    "status",
    "tieBreak",
    "scoreScale",
    "revision"
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Nonnegative decimal counter, at most 19 digits. String on JSON to preserve precision in JavaScript; compare numerically."
    },
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    }
  }
}
